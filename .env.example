# Подключение к базе
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop
# Порт, на котором PostgreSQL виден с хоста. Меняй, если 5432 занят
# локальной установкой PostgreSQL.
POSTGRES_HOST_PORT=5432
# Replica (лабораторная №4): пул для читающих запросов.
# Пустая строка — реплики нет, чтение идёт в primary.
DATABASE_REPLICA_URL=postgresql://shop:shop@postgres_replica:5432/shop
POSTGRES_REPLICA_HOST_PORT=5433
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replpass
# Порт, на котором API виден с хоста.
API_HOST_PORT=8000
RUN_MIGRATIONS=true
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# Партиционирование (лабораторная №3)
PARTITION_TABLE=orders
PARTITION_HORIZON_DAYS=3
PARTITION_GRANULARITY=month   # day | month

# Планировщик внутри приложения (заменяет cron).
# Ночью создаёт партиции вперёд, регулярно проверяет их наличие.
SCHEDULER_ENABLED=true
PARTITION_CREATE_HOUR=1
PARTITION_CHECK_INTERVAL_MINUTES=15

# Алертинг в Telegram.
# Реальные значения класть в .env — он в .gitignore и в репозиторий не попадает.
# Токен выдаёт @BotFather, chat_id можно узнать так:
#   1) написать боту любое сообщение;
#   2) curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#   3) взять result[0].message.chat.id
TELEGRAM_BOT_TOKEN=123456789:AA...replace_me...
TELEGRAM_CHAT_ID=123456789
ALERTS_ENABLED=true

# Шардирование (лабораторные №5 и №6)
# Порядок URL задаёт номера шардов: первый = shard 0.
# Пустая строка — шардирование выключено, /api/shards/* отдаёт 503.
SHARD_URLS=postgresql://shard:shard@shard0:5432/shard,postgresql://shard:shard@shard1:5432/shard,postgresql://shard:shard@shard2:5432/shard
# modulo | consistent
SHARD_STRATEGY=consistent
# Точек на кольце для каждого шарда. При 1 распределение получается
# 77/9/14 %, при 150 — 32/33/34 %.
SHARD_VIRTUAL_NODES=150
SHARD_POOL_MAX_SIZE=5
# Порты шардов на хосте.
SHARD0_HOST_PORT=5440
SHARD1_HOST_PORT=5441
SHARD2_HOST_PORT=5442
SHARD3_HOST_PORT=5443
